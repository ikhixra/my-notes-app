<!DOCTYPE html>
<html>
<head>
    <title>Edit Note</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(to right, #f7971e, #ffd200);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            width: 400px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            text-align: center;
        }

        h2 {
            margin-bottom: 20px;
            color: #333;
        }

        input {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border-radius: 6px;
            border: 1px solid #ccc;
            font-size: 14px;
        }

        button {
            width: 100%;
            padding: 12px;
            border: none;
            background: #f7971e;
            color: white;
            border-radius: 6px;
            cursor: pointer;
            font-size: 15px;
        }

        button:hover {
            background: #e67e22;
        }

        .back {
            display: inline-block;
            margin-top: 15px;
            text-decoration: none;
            color: #555;
        }

        .back:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>

<div class="card">
    <h2>✏️ Edit Note</h2>

    <form action="/update/<%= note._id %>?_method=PUT" method="POST">
        <input 
            type="text" 
            name="note" 
            value="<%= note.text %>" 
            required
        >

        <button type="submit">Update Note</button>
    </form>

    <a href="/" class="back">⬅ Back to Notes</a>
</div>

</body>
</html>